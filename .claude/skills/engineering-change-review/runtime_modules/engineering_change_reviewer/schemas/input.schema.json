{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema:engineering_change_reviewer_input@v1",
  "title": "Engineering Change Reviewer Semantic Input",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "path_entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "state": {"enum": ["added", "modified", "deleted", "kept_at_base"]}
      },
      "required": ["path", "state"]
    },
    "claimed_gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gate_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,191}$"},
        "command": {"type": "string", "minLength": 1},
        "working_directory": {"type": "string", "minLength": 1},
        "expected_result": {"type": "string", "minLength": 1}
      },
      "required": ["gate_id", "command", "working_directory", "expected_result"]
    },
    "prior_finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,191}$"},
        "severity": {"enum": ["BLOCKING", "MEDIUM", "LOW", "NIT"]},
        "body": {"type": "string", "minLength": 1}
      },
      "required": ["finding_id", "severity", "body"]
    },
    "supporting_document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,191}$"},
        "context_role": {
          "enum": [
            "governing_contract",
            "dependency_contract",
            "migration_guidance",
            "registry_snapshot",
            "current_inspection",
            "recovery_source"
          ]
        },
        "body": {"type": "string", "minLength": 1}
      },
      "required": ["document_id", "context_role", "body"]
    }
  },
  "properties": {
    "schema_version": {"const": "engineering_change_reviewer_input_v1"},
    "module_id": {"const": "engineering_change_reviewer"},
    "review_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_mode": {"enum": ["pre_commit_candidate", "commit_ref"]},
        "intended_result": {"type": "string", "minLength": 1},
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": ["subject_mode", "intended_result", "acceptance_criteria"]
    },
    "frozen_change": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_ref": {"type": "string", "minLength": 1},
        "commit_ref": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "path_manifest": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/path_entry"}
        },
        "diff_text": {"type": "string", "minLength": 1},
        "working_tree_context": {"type": "string"}
      },
      "required": ["base_ref", "commit_ref", "path_manifest", "diff_text", "working_tree_context"]
    },
    "code_design_basis": {"type": "string", "minLength": 1},
    "claimed_gates": {
      "type": "array",
      "items": {"$ref": "#/$defs/claimed_gate"}
    },
    "prior_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/prior_finding"}
    },
    "supporting_documents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/supporting_document"}
    }
  },
  "required": [
    "schema_version",
    "module_id",
    "review_request",
    "frozen_change",
    "code_design_basis",
    "claimed_gates",
    "prior_findings",
    "supporting_documents"
  ]
}
