{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema:skill_candidate_reviewer_input@v3",
  "title": "Skill Candidate Reviewer Input",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "document_kind": {"enum": ["design_contract", "skill", "project_binding_addendum", "module_registration", "module_prompt", "schema", "validation_case", "projection", "registration_inspection"]},
        "body": {"type": "string", "minLength": 1}
      },
      "required": ["document_id", "document_kind", "body"]
    }
  },
  "properties": {
    "schema_version": {"const": "skill_candidate_reviewer_input_v3"},
    "module_id": {"const": "skill_candidate_reviewer"},
    "skill_candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skill_id": {"type": "string", "minLength": 1},
        "candidate_revision": {"type": "integer", "minimum": 1},
        "candidate_body": {"type": "string", "minLength": 1}
      },
      "required": ["skill_id", "candidate_revision", "candidate_body"]
    },
    "project_binding_addendum": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skill_id": {"type": "string", "minLength": 1},
        "binding_source_ref": {"type": "string", "minLength": 1},
        "addendum_body": {"type": "string", "minLength": 1}
      },
      "required": ["skill_id", "binding_source_ref", "addendum_body"]
    },
    "owning_design_closure": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/document"}},
    "source_and_projection_closure": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/document"}},
    "required_check_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "identity_owner_and_class",
          "entry_applicability_and_exit",
          "design_meaning_fidelity",
          "input_output_and_completion",
          "prompt_boundary_hygiene",
          "skill_agent_workflow_tool_separation",
          "module_source_closure",
          "host_projection_closure",
          "migration_and_retirement",
          "project_binding_boundary"
        ]
      }
    },
    "prior_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["open", "claimed_fixed", "accepted", "rejected"]},
          "body": {"type": "string", "minLength": 1}
        },
        "required": ["finding_id", "disposition", "body"]
      }
    }
  },
  "required": ["schema_version", "module_id", "owning_design_closure", "source_and_projection_closure", "required_check_ids", "prior_findings"],
  "oneOf": [
    {"required": ["skill_candidate"], "not": {"required": ["project_binding_addendum"]}},
    {"required": ["project_binding_addendum"], "not": {"required": ["skill_candidate"]}}
  ]
}
