{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema:skill_candidate_reviewer_output@v1",
  "title": "Skill Candidate Reviewer Output",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["block", "fix", "note"]},
        "check_id": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "accountable_owner_ref": {"type": "string", "minLength": 1},
        "required_change": {"type": "string", "minLength": 1}
      },
      "required": ["finding_id", "severity", "check_id", "evidence", "accountable_owner_ref", "required_change"]
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["passed", "finding"]},
        "finding_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "required": ["check_id", "disposition", "finding_ids"]
    }
  },
  "properties": {
    "layer_disposition": {"enum": ["passed", "non_pass", "blocked"]},
    "check_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check_result"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "safe_next_step": {"type": "string", "minLength": 1}
  },
  "required": ["layer_disposition", "check_results", "findings", "safe_next_step"]
}
