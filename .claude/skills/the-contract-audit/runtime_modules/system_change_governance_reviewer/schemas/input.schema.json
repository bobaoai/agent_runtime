{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema:system_change_governance_reviewer_input@v8",
  "title": "System Change Governance Reviewer Semantic Input",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "document_kind": {"enum": ["design_contract", "skill", "module_manifest", "module_prompt", "schema", "source_code", "test", "generated_projection"]},
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1}
      },
      "required": ["document_id", "document_kind", "title", "body"]
    },
    "authority_impact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "impact_id": {"type": "string", "minLength": 1},
        "owner_ref": {"type": "string", "minLength": 1},
        "intended_decision": {"type": "string", "minLength": 1},
        "decision_requirement_ref": {"type": "string", "minLength": 1}
      },
      "required": ["impact_id", "owner_ref", "intended_decision", "decision_requirement_ref"]
    },
    "implementation_impact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "impact_id": {"type": "string", "minLength": 1},
        "surface_kind": {"enum": ["design_intent", "code", "schema", "skill", "runtime_registration", "data", "migration", "contract_registry", "generated_projection", "test", "release", "deployment", "rollback", "roll_forward", "retirement"]},
        "owner_ref": {"type": "string", "minLength": 1},
        "current_truth_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "required": ["impact_id", "surface_kind", "owner_ref", "current_truth_refs"]
    },
    "work_package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "work_package_id": {"type": "string", "minLength": 1},
        "owner_ref": {"type": "string", "minLength": 1},
        "specialist_kind": {"enum": ["design", "skill", "runtime_registration", "engineering", "agency_platform", "product_authorization", "artifact_graph", "data", "timestamp", "contract_audit", "software_delivery"]},
        "input_contract_ref": {"type": "string", "minLength": 1},
        "completion_kind": {"enum": ["reviewable_candidate", "terminal_evidence"]},
        "implementation_impact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "required": ["work_package_id", "owner_ref", "specialist_kind", "input_contract_ref", "completion_kind", "implementation_impact_ids"]
    },
    "candidate": {
      "allOf": [
        {"$ref": "#/$defs/document"},
        {
          "type": "object",
          "properties": {
            "work_package_id": {"type": "string", "minLength": 1},
            "implementation_impact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          },
          "required": ["work_package_id", "implementation_impact_ids"]
        }
      ]
    },
    "external_result_requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirement_id": {"type": "string", "minLength": 1},
        "subject_ref": {"type": "string", "minLength": 1},
        "assurance_policy_ref": {"type": "string", "minLength": 1},
        "required_result_kind": {"type": "string", "minLength": 1}
      },
      "required": ["requirement_id", "subject_ref", "assurance_policy_ref", "required_result_kind"]
    }
  },
  "properties": {
    "schema_version": {"const": "system_change_governance_reviewer_input_v8"},
    "module_id": {"const": "system_change_governance_reviewer"},
    "system_change_case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "state": {"enum": ["captured", "scoped", "awaiting_authority_decision", "planned", "in_progress", "candidate_frozen", "under_review", "awaiting_admission", "awaiting_completion", "blocked", "closed", "rejected", "withdrawn", "aborted"]},
        "change_request": {"type": "string", "minLength": 1},
        "current_scope_assessment_ref": {"type": "string", "minLength": 1},
        "current_plan_ref": {"type": "string", "minLength": 1}
      },
      "required": ["case_id", "state", "change_request", "current_scope_assessment_ref", "current_plan_ref"]
    },
    "scope_assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assessment_id": {"type": "string", "minLength": 1},
        "primary_changed_subject_ref": {"type": "string", "minLength": 1},
        "primary_changed_subject_kind": {"type": "string", "minLength": 1},
        "primary_changed_subject_layer": {"type": "string", "minLength": 1},
        "operation": {"enum": ["create", "update", "promote", "split", "merge", "replace", "rename", "retire", "release", "deploy", "rollback", "roll_forward"]},
        "change_scope": {"enum": ["within_object", "cross_layer_handoff", "peer_responsibility", "authority_topology", "implementation_only"]},
        "materiality": {"enum": ["structural", "bounded", "non_material"]},
        "authority_impacts": {"type": "array", "items": {"$ref": "#/$defs/authority_impact"}},
        "implementation_impacts": {"type": "array", "items": {"$ref": "#/$defs/implementation_impact"}},
        "unresolved_ambiguity": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": ["assessment_id", "primary_changed_subject_ref", "primary_changed_subject_kind", "primary_changed_subject_layer", "operation", "change_scope", "materiality", "authority_impacts", "implementation_impacts", "unresolved_ambiguity"]
    },
    "system_change_plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan_id": {"type": "string", "minLength": 1},
        "work_packages": {"type": "array", "items": {"$ref": "#/$defs/work_package"}},
        "required_external_results": {"type": "array", "items": {"$ref": "#/$defs/external_result_requirement"}}
      },
      "required": ["plan_id", "work_packages", "required_external_results"]
    },
    "system_change_candidate_set": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_set_id": {"type": "string", "minLength": 1},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}
      },
      "required": ["candidate_set_id", "candidates"]
    },
    "governance_contract_closure": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/document"}},
    "prior_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["open", "claimed_fixed", "accepted", "rejected"]},
          "body": {"type": "string", "minLength": 1}
        },
        "required": ["finding_id", "disposition", "body"]
      }
    }
  },
  "required": ["schema_version", "module_id", "system_change_case", "scope_assessment", "system_change_plan", "system_change_candidate_set", "governance_contract_closure"]
}
