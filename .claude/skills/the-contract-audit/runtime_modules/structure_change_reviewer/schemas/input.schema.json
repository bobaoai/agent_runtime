{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema:structure_change_reviewer_input@v1",
  "title": "Structure Change Reviewer Semantic Input",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "document_kind": {"enum": ["charter", "design_contract", "structure_kind_profile", "registry_contract", "prior_decision"]},
        "owner_ref": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1}
      },
      "required": ["document_id", "document_kind", "owner_ref", "title", "body"]
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "peer_ref": {"type": "string", "minLength": 1},
        "owner_ref": {"type": "string", "minLength": 1},
        "owned_object": {"type": "string", "minLength": 1},
        "responsibility": {"type": "string", "minLength": 1},
        "handoffs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "required": ["peer_ref", "owner_ref", "owned_object", "responsibility", "handoffs"]
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proposal_id": {"type": "string", "minLength": 1},
        "operation": {"enum": ["create", "promote", "split", "merge", "replace", "rename", "retire"]},
        "structure_kind": {"type": "string", "minLength": 1},
        "structure_kind_profile_ref": {"type": "string", "minLength": 1},
        "subject_ref": {"type": "string", "minLength": 1},
        "current_owner_ref": {"type": ["string", "null"]},
        "proposed_owner_ref": {"type": "string", "minLength": 1},
        "proposed_owned_object": {"type": "string", "minLength": 1},
        "proposed_responsibility": {"type": "string", "minLength": 1},
        "proposed_handoffs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rationale": {"type": "string", "minLength": 1},
        "parent_authority_ref": {"type": "string", "minLength": 1},
        "scope_assessment_ref": {"type": "string", "minLength": 1}
      },
      "required": ["proposal_id", "operation", "structure_kind", "structure_kind_profile_ref", "subject_ref", "current_owner_ref", "proposed_owner_ref", "proposed_owned_object", "proposed_responsibility", "proposed_handoffs", "rationale", "parent_authority_ref", "scope_assessment_ref"]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_ref": {"type": "string", "minLength": 1},
        "parent_authority_ref": {"type": "string", "minLength": 1},
        "structure_kind": {"type": "string", "minLength": 1},
        "structure_kind_profile_ref": {"type": "string", "minLength": 1},
        "completeness_attestation_ref": {"type": "string", "minLength": 1},
        "peers": {"type": "array", "items": {"$ref": "#/$defs/peer"}}
      },
      "required": ["snapshot_ref", "parent_authority_ref", "structure_kind", "structure_kind_profile_ref", "completeness_attestation_ref", "peers"]
    },
    "prior_finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["open", "claimed_fixed", "accepted", "rejected"]},
        "body": {"type": "string", "minLength": 1}
      },
      "required": ["finding_id", "disposition", "body"]
    }
  },
  "properties": {
    "schema_version": {"const": "structure_change_reviewer_input_v1"},
    "module_id": {"const": "structure_change_reviewer"},
    "structure_change_proposal": {"$ref": "#/$defs/proposal"},
    "peer_registry_snapshot": {"$ref": "#/$defs/snapshot"},
    "governance_contract_closure": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/document"}},
    "required_check_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["owned_object_overlap", "missing_responsibility", "specialization_vs_new_peer", "structure_kind_validity", "promotion_boundary", "split_partition", "merge_coverage", "replacement_and_retirement_coverage", "rename_identity", "handoff_closure", "parent_authority_alignment", "unnecessary_complexity"]}
    },
    "prior_findings": {"type": "array", "items": {"$ref": "#/$defs/prior_finding"}}
  },
  "required": ["schema_version", "module_id", "structure_change_proposal", "peer_registry_snapshot", "governance_contract_closure", "required_check_ids", "prior_findings"]
}
