{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema:system_change_plan_reviewer_input@v10",
  "title": "System Change Plan Reviewer Input",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "owner_ref": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1}
      },
      "required": ["document_id", "owner_ref", "title", "body"]
    },
    "prior_finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["open", "claimed_fixed", "accepted", "rejected"]},
        "body": {"type": "string", "minLength": 1}
      },
      "required": ["finding_id", "disposition", "body"]
    }
  },
  "properties": {
    "schema_version": {"const": "system_change_plan_reviewer_input_v10"},
    "module_id": {"const": "system_change_plan_reviewer"},
    "system_change_plan": {"$ref": "#/$defs/document"},
    "governing_contract_closure": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/document"}
    },
    "required_check_ids": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "prefixItems": [
        {"const": "scope_and_unresolved_decisions"},
        {"const": "layer_classification"},
        {"const": "change_goal_and_reason"},
        {"const": "dependency_order"},
        {"const": "step_route_closure"},
        {"const": "frozen_upstream_prerequisite"},
        {"const": "reviewer_routing"},
        {"const": "no_execution_ownership"}
      ],
      "items": false
    },
    "prior_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/prior_finding"}
    }
  },
  "required": [
    "schema_version",
    "module_id",
    "system_change_plan",
    "governing_contract_closure",
    "required_check_ids",
    "prior_findings"
  ]
}
