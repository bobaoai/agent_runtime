{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema:engineering_change_reviewer_input@v4",
  "title": "Engineering Change Reviewer Input",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "hashed_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["ref", "sha256"]
    },
    "hashed_body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "body": {"type": "string", "minLength": 1}
      },
      "required": ["ref", "sha256", "body"]
    },
    "subject_path": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "state": {"enum": ["added", "modified", "deleted"]},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["path", "state", "content_sha256"]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command_id": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "cwd": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "network_policy": {"enum": ["denied", "declared"]},
        "expected_result": {"type": "string", "minLength": 1}
      },
      "required": ["command_id", "argv", "cwd", "timeout_seconds", "network_policy", "expected_result"]
    }
  },
  "properties": {
    "schema_version": {"const": "engineering_change_reviewer_input_v4"},
    "module_id": {"const": "engineering_change_reviewer"},
    "system_change_plan_step": {"$ref": "#/$defs/hashed_body"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit_ref": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "parent_ref": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/subject_path"}}
      },
      "required": ["commit_ref", "parent_ref", "subject_sha256", "diff_sha256", "paths"]
    },
    "code_design_basis": {"$ref": "#/$defs/hashed_body"},
    "sandbox_command_plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "commands": {"type": "array", "items": {"$ref": "#/$defs/command"}}
      },
      "required": ["ref", "sha256", "commands"]
    },
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "prior_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["open", "claimed_fixed", "accepted", "rejected"]},
          "body": {"type": "string", "minLength": 1}
        },
        "required": ["finding_id", "disposition", "body"]
      }
    }
  },
  "required": ["schema_version", "module_id", "system_change_plan_step", "subject", "code_design_basis", "sandbox_command_plan", "acceptance_criteria", "prior_findings"]
}
