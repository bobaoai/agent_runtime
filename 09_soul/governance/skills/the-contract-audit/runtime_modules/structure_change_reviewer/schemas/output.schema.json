{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema:structure_change_reviewer_output@v1",
  "title": "Structure Change Review Result",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["block", "fix", "note"]},
        "finding_class": {"enum": ["structural_defect", "context_insufficiency", "snapshot_conflict", "parent_authority_conflict"]},
        "target_kind": {"enum": ["proposal", "peer_snapshot", "peer", "structure_kind_profile", "parent_authority", "handoff"]},
        "target_ref": {"type": "string", "minLength": 1},
        "quoted_evidence": {"type": "string", "minLength": 1},
        "requirement": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "accountable_owner_ref": {"type": "string", "minLength": 1},
        "required_change": {"type": "string", "minLength": 1}
      },
      "required": ["finding_id", "severity", "finding_class", "target_kind", "target_ref", "quoted_evidence", "requirement", "impact", "accountable_owner_ref", "required_change"]
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check_id": {"enum": ["owned_object_overlap", "missing_responsibility", "specialization_vs_new_peer", "structure_kind_validity", "promotion_boundary", "split_partition", "merge_coverage", "replacement_and_retirement_coverage", "rename_identity", "handoff_closure", "parent_authority_alignment", "unnecessary_complexity"]},
        "disposition": {"enum": ["passed", "finding", "not_evaluable"]},
        "finding_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "required": ["check_id", "disposition", "finding_ids"],
      "allOf": [
        {"if": {"properties": {"disposition": {"const": "passed"}}, "required": ["disposition"]}, "then": {"properties": {"finding_ids": {"maxItems": 0}}}},
        {"if": {"properties": {"disposition": {"enum": ["finding", "not_evaluable"]}}, "required": ["disposition"]}, "then": {"properties": {"finding_ids": {"minItems": 1}}}}
      ]
    }
  },
  "properties": {
    "verdict": {"enum": ["passed", "non_pass", "blocked"]},
    "observed_conditions": {"type": "array", "uniqueItems": true, "items": {"enum": ["distinct_responsibility", "overlap_present", "existing_specialization_available", "promotion_boundary_coherent", "split_partition_coherent", "merge_coverage_coherent", "replacement_coverage_coherent", "rename_identity_coherent", "retirement_coverage_preserved", "responsibility_gap", "unnecessary_complexity"]}},
    "check_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check_result"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "safe_next_step": {"type": "string", "minLength": 1}
  },
  "required": ["verdict", "observed_conditions", "check_results", "findings", "safe_next_step"],
  "allOf": [
    {"if": {"properties": {"verdict": {"const": "passed"}}, "required": ["verdict"]}, "then": {"properties": {"findings": {"not": {"contains": {"properties": {"severity": {"enum": ["block", "fix"]}}, "required": ["severity"]}}}}}},
    {"if": {"properties": {"verdict": {"const": "non_pass"}}, "required": ["verdict"]}, "then": {"properties": {"findings": {"contains": {"properties": {"severity": {"enum": ["block", "fix"]}}, "required": ["severity"]}}}}},
    {"if": {"properties": {"verdict": {"const": "blocked"}}, "required": ["verdict"]}, "then": {"properties": {"findings": {"contains": {"properties": {"severity": {"const": "block"}, "finding_class": {"const": "context_insufficiency"}}, "required": ["severity", "finding_class"]}}}}}
  ]
}
