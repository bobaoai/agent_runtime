{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema:design_contract_reviewer_input@v3",
  "title": "Design Contract Reviewer Semantic Input",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "candidate_document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,191}$"},
        "layer": {"enum": ["Charter", "T0", "T1", "T2"]},
        "title": {"type": "string", "minLength": 1},
        "owner_ref": {"type": "string", "minLength": 1},
        "parent_ref": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "owned_object": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1}
      },
      "required": ["document_id", "layer", "title", "owner_ref", "parent_ref", "owned_object", "body"]
    },
    "context_document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,191}$"},
        "context_role": {
          "enum": [
            "charter",
            "governing_contract",
            "parent_contract",
            "peer_contract",
            "dependency_contract",
            "code_projection",
            "current_inspection",
            "prior_decision"
          ]
        },
        "owner_ref": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1}
      },
      "required": ["document_id", "context_role", "owner_ref", "title", "body"]
    },
    "prior_finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,191}$"},
        "disposition": {"enum": ["open", "claimed_fixed", "accepted", "rejected"]},
        "body": {"type": "string", "minLength": 1}
      },
      "required": ["finding_id", "disposition", "body"]
    }
  },
  "properties": {
    "schema_version": {"const": "design_contract_reviewer_input_v3"},
    "module_id": {"const": "design_contract_reviewer"},
    "review_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_purpose": {
          "enum": ["owner_design_decision", "peer_boundary_design_review", "contract_admission"]
        },
        "intended_result": {"type": "string", "minLength": 1},
        "architecture_change_summary": {"type": "string", "minLength": 1}
      },
      "required": ["review_purpose", "intended_result", "architecture_change_summary"]
    },
    "candidate_documents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate_document"}
    },
    "context_documents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/context_document"}
    },
    "required_check_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "intent_and_reader_result",
          "layer_owner_and_parent",
          "peer_authority_and_inheritance",
          "boundary_coherence",
          "design_and_code_truth_separation",
          "failure_completion_and_rollback",
          "implementability_without_redesign",
          "review_approval_and_admission"
        ]
      }
    },
    "prior_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/prior_finding"}
    }
  },
  "required": [
    "schema_version",
    "module_id",
    "review_request",
    "candidate_documents",
    "context_documents",
    "required_check_ids",
    "prior_findings"
  ]
}
